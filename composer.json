{
  "name": "leadingsystems/merconis-languageselector",
  "description": "Merconis language selector bundle for Contao",
  "keywords": [
    "contao",
    "leading systems",
    "merconis",
    "bundle"
  ],
  "type": "contao-bundle",
  "license": "proprietary",
  "require": {
    "php": "^7.4 || ^8.0",
    "contao/core-bundle": "^4.13 || ^5.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "autoload-dev": {
    "psr-4": {
      "LeadingSystems\\LanguageSelectorBundle\\Tests\\": "tests/"
    }
  },
  "autoload": {
    "psr-4": {
      "LeadingSystems\\LanguageSelectorBundle\\": "src/"
    },
    "classmap": [
      "src/Resources/contao/"
    ],
    "exclude-from-classmap": [
      "src/Resources/contao/config/",
      "src/Resources/contao/dca/",
      "src/Resources/contao/languages/",
      "src/Resources/contao/templates/"
    ]
  },
  "extra": {
    "contao-manager-plugin": "LeadingSystems\\LanguageSelectorBundle\\ContaoManager\\Plugin",
    "branch-alias": {
      "dev-master": "3.1.x-dev",
      "dev-develop": "3.1.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "php-http/discovery": true
    }
  }
}
