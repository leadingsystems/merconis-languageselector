<div class="ls_languageSelector <?php echo $this->class; ?> block"<?php echo $this->cssID; ?><?php if ($this->style): ?> style="<?php echo $this->style; ?>"<?php endif; ?>>
<!-- indexer::stop -->
    <div class="current-language-info">
        <?php echo sprintf(
            $GLOBALS['TL_LANG']['MSC']['infoTextCurrentLanguage'],
            '<span class="current-language" lang="'
            . $this->correspondingPages[$this->currentLanguage]['languageCode']
            . '">'
            . $this->correspondingPages[$this->currentLanguage]['languageTitle']
            . '</span>'
        ); ?>
    </div>
    <?php
        if (count($this->correspondingPages) > 1) {
            ?>
            <div class="more-available-languages">
                <h3><?php echo $GLOBALS['TL_LANG']['MSC']['infoTextOtherAvailableLanguages']; ?></h3>
                <ul>
                <?php
                    foreach ($this->correspondingPages as $str_language => $arr_correspondingPage) {
                        if ($str_language === $this->currentLanguage) {
                            continue;
                        }
                        ?>
                        <li lang="<?php echo $arr_correspondingPage['languageCode'] ?>">
                            <a class="available-language"
                               href="<?php echo $arr_correspondingPage['href'] ?>"
                               hreflang="<?php echo $arr_correspondingPage['languageCode'] ?>"
                               lang="<?php echo $arr_correspondingPage['languageCode'] ?>"
                               title="<?php echo $arr_correspondingPage['languageTitle'] ?>">
                                <?php echo $arr_correspondingPage['languageTitle']; ?>
                            </a>
                        </li>
                        <?php
                    }
                ?>
                </ul>
            </div>
            <?php
        }
    ?>
<!-- indexer::continue -->
</div>
